{
  "name": "relatte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify": "npm run check && npm test && npm run trust:mutations && npm run trust:replay && npm run build",
    "trust:mutations": "node --experimental-strip-types scripts/foundation-of-trust-mutations.mjs",
    "trust:replay": "node --experimental-strip-types scripts/foundation-of-trust-replay.mjs"
  },
  "dependencies": {
    "json-canonicalize": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
