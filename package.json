    "enter:song": "node --experimental-strip-types demo/enterable-song.ts"
  },
  "dependencies": {
    "json-canonicalize": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
