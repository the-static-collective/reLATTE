{
  "name": "relatte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "browse:genesis": "node --experimental-strip-types demo/browse-genesis.ts",
    "walk:genesis": "node --experimental-strip-types demo/walk-genesis.ts",
