{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/reLATTE/schemas/organ-contract-v0.schema.json",
  "title": "OrganContractV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "version",
    "owner_project",
    "accepted_crossing_kinds",
    "allowed_dispositions",
    "effect_classes",
    "receipt_kinds",
    "authority_scope",
    "non_authorities"
  ],
  "properties": {
    "schema": {
      "const": "relatte.organ-contract/v0"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner_project": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "accepted_crossing_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_schema_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_dispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HOLD",
          "ADMIT",
          "REFUSE",
          "RETURN"
        ]
      }
    },
    "effect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "local-state-change",
          "artifact-created",
          "descendant-created",
          "capability-issued",
          "capability-revoked",
          "return-created",
          "projection-updated",
          "field-pressure-updated",
          "unknown"
        ]
      }
    },
    "receipt_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "authority_scope": {
      "const": "owner-local"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "implementation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "non_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}