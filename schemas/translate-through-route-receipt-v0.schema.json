{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/reLATTE/schemas/translate-through-route-receipt-v0.schema.json",
  "title": "TranslateThroughRouteReceiptExtensionV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "route_state",
    "stage_receipt_ids",
    "stage_output_refs",
    "completed_stage_count",
    "expected_stage_count",
    "last_addressable_ref",
    "semantic_equivalence_claim",
    "laws"
  ],
  "properties": {
    "schema": {
      "const": "relatte.translate-through-route-receipt/v0"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^relatte-translate-through-v0:[0-9a-f]{64}$"
    },
    "route_state": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "HELD",
        "REFUSED",
        "FAILED"
      ]
    },
    "stage_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stage_output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed_stage_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_stage_count": {
      "type": "integer",
      "minimum": 2
    },
    "last_addressable_ref": {
      "type": "string",
      "minLength": 1
    },
    "semantic_equivalence_claim": {
      "const": "none"
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
