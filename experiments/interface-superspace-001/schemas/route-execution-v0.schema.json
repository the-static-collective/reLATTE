{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relatte.route-execution.experimental/v0"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "actual_interfaces_traversed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "actual_relation_receipts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "native_particular_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "crossing_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "residuals": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    },
    "source": {
      "type": "object"
    },
    "particulars": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "execution_id",
    "route_id",
    "plan_digest",
    "actual_interfaces_traversed",
    "actual_relation_receipts",
    "native_particular_refs",
    "crossing_refs",
    "result",
    "residuals",
    "failures",
    "source",
    "particulars",
    "execution_digest"
  ],
  "additionalProperties": false
}
