{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "properties": {
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "representation",
        "facts",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "interface_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "emits": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "interface_id",
        "emits"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "network": {
          "type": "boolean"
        },
        "preserve_ancestry": {
          "type": "boolean"
        },
        "mutation_authority": {
          "type": "boolean"
        },
        "loss_budget": {
          "type": "integer",
          "minimum": 0
        },
        "ordering": {
          "enum": [
            "any",
            "ordered"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "local_state": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "network",
        "preserve_ancestry",
        "mutation_authority",
        "loss_budget",
        "ordering",
        "reversible",
        "witnesses",
        "permissions",
        "local_state",
        "max_depth",
        "max_candidates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "from",
    "state",
    "goal",
    "constraints"
  ],
  "additionalProperties": false
}
