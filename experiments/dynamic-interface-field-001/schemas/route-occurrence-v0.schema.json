{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "route-occurrence-v0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relatte.dynamic-route-occurrence.experimental/v0"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "field_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "field_plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "view_digest": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "operation_tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "relatte.dynamic-operation-ticket.experimental/v0"
          },
          "ticket_id": {
            "type": "string",
            "minLength": 1
          },
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "minLength": 1
          },
          "offer_id": {
            "type": "string",
            "minLength": 1
          },
          "interface_id": {
            "type": "string",
            "minLength": 1
          },
          "grant_id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "observe",
              "propose",
              "configure",
              "perturb",
              "transmit",
              "receive",
              "mutate"
            ]
          },
          "permission": {
            "enum": ["observe", "propose", "mutate"]
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "use": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "public_key": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "schema",
          "ticket_id",
          "world_id",
          "head",
          "offer_id",
          "interface_id",
          "grant_id",
          "subject",
          "operation",
          "permission",
          "at_ms",
          "use",
          "public_key",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "lifecycle_residuals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nested": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "composition_id": {
            "type": "string",
            "minLength": 1
          },
          "member_plan": {
            "type": "object",
            "properties": {
              "schema": {
                "const": "relatte.dynamic-route-proposal.experimental/v0"
              },
              "field_plan_id": {
                "type": "string",
                "minLength": 1
              },
              "view_digest": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "integer",
                "minimum": 0
              },
              "frontiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "world_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "head": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": ["world_id", "head", "count"],
                  "additionalProperties": false
                }
              },
              "route": {
                "type": "object"
              },
              "doors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "offer_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "descriptor": {
                      "type": "object"
                    },
                    "descriptor_digest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expires_at": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "parents": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "world_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "offer_id",
                    "descriptor",
                    "descriptor_digest",
                    "expires_at",
                    "parents",
                    "world_id",
                    "event_ref"
                  ],
                  "additionalProperties": false
                }
              },
              "relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "offer_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "descriptor": {
                      "type": "object"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "world_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "interface_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "offer_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "descriptor_digest": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "world_id",
                        "interface_id",
                        "offer_id",
                        "descriptor_digest"
                      ],
                      "additionalProperties": false
                    },
                    "destination": {
                      "type": "object",
                      "properties": {
                        "world_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "interface_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "offer_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "descriptor_digest": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "world_id",
                        "interface_id",
                        "offer_id",
                        "descriptor_digest"
                      ],
                      "additionalProperties": false
                    },
                    "expires_at": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "world_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "offer_id",
                    "descriptor",
                    "source",
                    "destination",
                    "expires_at",
                    "world_id",
                    "event_ref"
                  ],
                  "additionalProperties": false
                }
              },
              "authority": {
                "type": "array",
                "maxItems": 0
              },
              "field_plan_digest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "schema",
              "field_plan_id",
              "view_digest",
              "observed_at",
              "frontiers",
              "route",
              "doors",
              "relations",
              "authority",
              "field_plan_digest"
            ],
            "additionalProperties": false
          },
          "occurrence": {
            "type": "object"
          }
        },
        "required": ["composition_id", "member_plan", "occurrence"],
        "additionalProperties": false
      }
    },
    "execution": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": ["succeeded", "failed"]
    },
    "dynamic_execution_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "occurrence_id",
    "field_plan_id",
    "field_plan_digest",
    "view_digest",
    "subject",
    "operation_tickets",
    "lifecycle_residuals",
    "failures",
    "nested",
    "execution",
    "result",
    "dynamic_execution_digest"
  ],
  "additionalProperties": false
}
