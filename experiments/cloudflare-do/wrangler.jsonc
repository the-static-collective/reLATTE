{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "relatte-mw-durable-pilot",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MW_RECEIVER",
        "class_name": "MysticalWhimseyReceiver"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MysticalWhimseyReceiver"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
